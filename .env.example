# ============================================
# EAOS — .env.example — جادوگر v3.0.0 — پشتیبانی صفر — Zero Support
# cp .env.example .env → ./install.sh
# ============================================

# --- LLM — برای ایجنت ---
# چیه؟ هوش مصنوعی برای ایجنت — گزینه: ollama (لوکال رایگان), openai, mock
LOCAL_LLM_ENDPOINT=http://localhost:11434/api/generate
LOCAL_LLM_MODEL=llama3-8b
LLM_PROVIDER=ollama
OPENAI_API_KEY=
MAX_DAILY_SPEND_USD=5.0
LOCAL_CONFIDENCE_THRESHOLD=0.7

# --- DB ---
DB_PATH=sqlite:///eaos.db

# --- Trading — ترید ---
TRADING_MAX_POSITION_PCT=0.10
TRADING_MAX_DAILY_LOSS_PCT=0.02
TRADING_KILL_SWITCH=true
TRADING_ENABLED=false

# --- Voice ---
VOICE_STT=faster-whisper
VOICE_TTS=piper
VOICE_SAMPLE_RATE=16000

# --- Finance ---
FINANCE_CURRENCY=USD
FINANCE_DECIMAL_PLACES=4

# --- SMS — برای ناتیف ترید ---
# چیه؟ وقتی ترید می‌شه پیامک می‌ده — گزینه: ghasedak, kavenegar, mock
SMS_PROVIDER=mock
SMS_API_KEY=

# --- Notification System — سقف 10/10 — جدید v3.0.0 ---
# چیه؟ اطلاع‌رسانی ایجنت + ترید + صدا — کانال‌ها: in_app + sms + telegram
NOTIF_IN_APP=true
NOTIF_EMAIL=false
NOTIF_SMS=true
NOTIF_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
